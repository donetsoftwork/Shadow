  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Hand.Data" Version="0.2.2-alpha" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\ShadowSql.Core\ShadowSql.Core.csproj" />
    <ProjectReference Include="..\ShadowSql.Queries\ShadowSql.Queries.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Hand.Core" Version="0.3.1.13-alpha" />
  </ItemGroup>
</Project>
